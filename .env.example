# --- Admin ---
# ADMIN_PASSWORD MÅSTE vara en bcrypt-hash, inte lösenordet i klartext.
# Generera med:
#   node -e "const b=require('bcryptjs'); b.hash('DITT_LÖSENORD', 10).then(console.log)"
ADMIN_PASSWORD=$2b$10$byt-ut-detta-mot-en-riktig-bcrypt-hash

# Generera med: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generera-en-lang-slumpmassig-strang-har

# --- Gmail (valfritt) ---
# Utan dessa skickas ingen e-post och ingen polling sker. Backend varnar
# vid uppstart om de saknas.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=cup@example.se
ADMIN_NOTIFY_EMAIL=din@epost.se

# --- Server ---
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://cup.landvetterif.se
# Sökväg till SQLite-databasen. Sätts av docker-compose till /data/cups.db.
# DB_PATH=./data/cups.db

# --- Frontend (byggtidsvariabler) ---
# docker-compose.prod.yml läser DESSA härifrån och skickar dem som build-args.
# De bakas in i bundlen vid bygget, så en ändring kräver `up --build`.
# Lämnas de tomma slutar webbanalysen fungera.
VITE_UMAMI_URL=https://umami.example.se
VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_UMAMI_SHARE_URL=https://umami.example.se/share/xxxxxxxxxxxxxxxx/lif-cup-reader
