# Umami webbanalys (valfritt)
# Lägg till dessa i .env (eller .env.local) för att aktivera spårning och admin-embed.

# URL till din självhostade Umami-instans
VITE_UMAMI_URL=https://umami.din-server.se

# Website-ID från Umami (Settings → Websites)
VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Share-URL för admin-embed (Umami → Websites → Share → aktivera och kopiera URL)
VITE_UMAMI_SHARE_URL=https://umami.din-server.se/share/xxxxxxxxxxxxxxxx/lif-cup-reader
